# ============================================================
# Maritime VTS Agent - 环境变量配置
# ============================================================
# 复制本文件为 .env 并填入真实凭据，.env 不要提交到 Git
# ============================================================

# ---- DeepSeek LLM 配置（OpenAI 兼容协议） --------------------
# 到 https://platform.deepseek.com 创建 API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat = DeepSeek-V3（默认）
# deepseek-reasoner = DeepSeek-R1（推理模式，更强但更贵）
LLM_MODEL=deepseek-chat

# ---- Embedding 模型 -----------------------------------------
# 仍使用本地 sentence-transformers，无需 API Key
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- 可选：模型缓存目录 --------------------------------------
# Windows 中文路径下如果遇到 HuggingFace / sentence-transformers 缓存问题，
# 可以指定一个纯 ASCII 可写目录；不填则程序自动选择系统缓存目录。
# VTS_HF_CACHE_DIR=D:\vts_hf_cache
